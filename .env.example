# ------------------------------------------------------------
# Model providers (server defaults; each user can override in Settings)
# ------------------------------------------------------------

# Answer model: "ollama" (local) or "openai"
LLM_PROVIDER=ollama
# Embeddings: "local" (sentence-transformers on this machine) or "openai"
EMBEDDING_PROVIDER=local

# Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=8192
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL).
# Optional: users can also save their own key in Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Describe images / video frames with a vision model (in addition to OCR)
VISION_ENABLED=true

# ------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_MIN_SCORE=0.01
CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=4500
QUERY_REWRITE=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ------------------------------------------------------------
# Media
# ------------------------------------------------------------
TESSERACT_PATH=
FFMPEG_PATH=
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
VIDEO_MAX_FRAMES=12
VIDEO_VISION_FRAMES=6

# ------------------------------------------------------------
# Uploads
# ------------------------------------------------------------
MAX_UPLOAD_MB=500
# Let users add localhost / private-network URLs (off for safety)
ALLOW_PRIVATE_URLS=false

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# Database, uploads and generated secrets
DATA_DIR=data
# Per-user search indexes
VECTORSTORE_DIR=vectorstore

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Leave empty to auto-generate in DATA_DIR/.jwt_secret
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Encrypts users' saved API keys. Leave empty to auto-generate in
# DATA_DIR/.encryption_key. Back this file up: losing it makes saved keys unreadable.
APP_ENCRYPTION_KEY=
# Defaults to DATA_DIR/app.db
DATABASE_PATH=
